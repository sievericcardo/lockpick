@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix pol: <http://www.smolang.org/greenhouseDT-policy#> .
@prefix ast: <http://www.smolang.org/greenhouseDT#> .

pol:wateringRequestConstraint a odrl:Constraint ;
    pol:identifier "urn:uuid:wateringRequestConstraint" ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand pol:WateringPurpose .

pol:researchRequestConstraint a odrl:Constraint ;
    pol:identifier "urn:uuid:researchRequestConstraint" ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:AcademicResearch .

pol:marketingRequestConstraint a odrl:Constraint ;
    pol:identifier "urn:uuid:marketingRequestConstraint" ;
