    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Maintenance .

<urn:uuid:plant1-greenhouse-use-watering-request> a odrl:Request ;
    pol:identifier "urn:uuid:plant1-greenhouse-use-watering-request" ;
    odrl:permission <urn:uuid:plant1-greenhouse-use-watering-permission> .

<urn:uuid:plant1-greenhouse-use-watering-permission> a odrl:Permission ;
    pol:identifier "urn:uuid:plant1-greenhouse-use-watering-permission" ;
    odrl:assignee ast:greenhouse ;
    odrl:assigner ast:plant1 ;
    odrl:action odrl:use ;
    odrl:target ast:plantId, ast:idealMoisture, ast:potId, ast:hasMoisture ;
    <https://w3id.org/force/sotw#context> pol:wateringRequestConstraint .

